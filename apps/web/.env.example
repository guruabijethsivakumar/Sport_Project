# PlayMatch Web Client Environment Variables
VITE_DEV_PORT=3000
VITE_DEV_PROXY_TARGET=http://localhost:5000
VITE_API_BASE_URL=/api/v1
VITE_QUERY_POLLING_INTERVAL_MS=10000
VITE_API_TIMEOUT_MS=15000

# Feature Modes (mock | live)
VITE_FEATURE_RECOMMENDATIONS_MODE=live
VITE_FEATURE_TEAMS_MODE=live
VITE_FEATURE_RESULTS_MODE=live
VITE_FEATURE_NOTIFICATIONS_MODE=live
VITE_FEATURE_RELIABILITY_MODE=live

# Google Identity Services Client ID (leave empty to disable Google Sign-In)
VITE_GOOGLE_CLIENT_ID=
